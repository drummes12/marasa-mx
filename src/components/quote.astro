---
import Mail from './icons/mail.astro'
import Section from '@/components/section.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section
  id='gallery'
  class='flex flex-col items-center justify-center px-8 md:px-24 pb-14'
>
  <article
    class='w-full bg-primary-coral/10 text-primary-blue px-8 py-12 rounded-lg flex flex-col items-center justify-center text-center gap-8'
  >
    <Mail class='size-14 stroke-1' />
    <h1 class='text-2xl sm:text-4xl tracking-[0.5rem] uppercase font-semibold'>
      {t('quote.title')}
    </h1>
    <p class='text-lg sm:text-xl tracking-wider font-light'>
      {t('quote.paragraph')}
    </p>
    <a
      class='px-10 py-5 bg-primary-coral text-white uppercase rounded-md text-lg tracking-widest cursor-pointer hover:contrast-125 hover:scale-105 transition duration-300'
      href='https://wa.me/523221751155?text=Hola%2C%20vi%20informaci%C3%B3n%20sobre%20Marasa%20en%20su%20p%C3%A1gina%20web%20y%20me%20gustar%C3%ADa%20saber%20m%C3%A1s.%20%C2%BFMe%20podr%C3%ADan%20compartir%20m%C3%A1s%20detalles%2C%20por%20favor%3F'
      target='_blank'
      rel='noopener noreferrer'
      aria-label='Cotiza con nosotros en WhatsApp'
    >
      {t('quote.button')}
    </a>
  </article>
</Section>
