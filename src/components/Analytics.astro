    "addressLocality": "Puerto Vallarta",
    "addressRegion": "Jalisco",
    "postalCode": "48300",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 20.653407,
    "longitude": -105.225021
  },
  "openingHours": "Mo-Fr 09:00-18:00",
  "priceRange": "$$$",
  "areaServed": {
    "@type": "City",
    "name": "Puerto Vallarta"
  }
}
</script>