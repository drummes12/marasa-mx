---
import Section from '@/components/section.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section class='py-16 px-8 md:px-24'>
  <div class='max-w-4xl mx-auto'>
    <div class='mb-12 text-center'>
      <p class='text-lg text-gray-600 leading-relaxed'>
        {t('privacy.content.intro')}
      </p>
    </div>

    <div class='space-y-8'>
      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.collection.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.collection.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.use.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.use.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.protection.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.protection.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.sharing.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.sharing.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.rights.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.rights.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.contact.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.contact.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.updates.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.updates.text')}
        </p>
      </div>
    </div>

    <div class='mt-12 flex justify-center'>
      <div class='w-full md:w-fit min-w-48 h-full rounded-sm border-2 border-primary-coral group overflow-hidden'>
        <a href='/' class='relative block'>
          <div class='absolute inset-0 w-full h-full bg-primary-coral -translate-x-full group-hover:translate-x-0 transition-transform duration-300 ease-in-out z-0'></div>
          <div class='flex-1 relative z-10 flex flex-row items-center justify-center gap-4 px-6 py-4'>
            <h4 class='text-md font-semibold uppercase text-primary-coral transition-colors duration-300 group-hover:text-white'>
              Volver al inicio
            </h4>
          </div>
        </a>
      </div>
    </div>
  </div>
</Section>