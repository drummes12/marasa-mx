---
import Section from '@/components/section.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Section class='py-16 px-8 md:px-24'>
  <div class='max-w-4xl mx-auto'>
    <article class='mb-12 text-center'>
      <h2 class='text-2xl font-bold text-primary-blue mb-4'>
        {t('privacy.company')}
      </h2>
      <p class='text-sm text-gray-500 mb-6'>
        {t('privacy.lastUpdate')}
      </p>
      <p class='text-lg text-gray-600 leading-relaxed'>
        {t('privacy.content.intro')}
      </p>
    </article>

    <article class='space-y-8'>
      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.provider.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.provider.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.purpose.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.purpose.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.usage.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.usage.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.propertyInfo.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.propertyInfo.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.intellectualProperty.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.intellectualProperty.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.dataProtection.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.dataProtection.text')}
        </p>
      </div>

      <div class='bg-white p-6 rounded-lg border-l-4 border-primary-coral'>
        <h4 class='text-lg font-semibold text-primary-blue mb-4'>
          {t('privacy.content.privacyPolicy.title')}
        </h4>
        
        <div class='space-y-6'>
          <div>
            <h5 class='text-md font-semibold text-primary-blue mb-2'>
              {t('privacy.content.collection.title')}
            </h5>
            <div class='text-gray-700 leading-relaxed text-sm' set:html={t('privacy.content.collection.text').replace(/\n/g, '<br>')}>
            </div>
          </div>

          <div>
            <h5 class='text-md font-semibold text-primary-blue mb-2'>
              {t('privacy.content.use.title')}
            </h5>
            <div class='text-gray-700 leading-relaxed text-sm' set:html={t('privacy.content.use.text').replace(/\n/g, '<br>')}>
            </div>
          </div>

          <div>
            <h5 class='text-md font-semibold text-primary-blue mb-2'>
              {t('privacy.content.cookies.title')}
            </h5>
            <p class='text-gray-700 leading-relaxed text-sm'>
              {t('privacy.content.cookies.text')}
            </p>
          </div>

          <div>
            <h5 class='text-md font-semibold text-primary-blue mb-2'>
              {t('privacy.content.control.title')}
            </h5>
            <p class='text-gray-700 leading-relaxed text-sm'>
              {t('privacy.content.control.text')}
            </p>
          </div>

          <div>
            <h5 class='text-md font-semibold text-primary-blue mb-2'>
              {t('privacy.content.conflicts.title')}
            </h5>
            <p class='text-gray-700 leading-relaxed text-sm'>
              {t('privacy.content.conflicts.text')}
            </p>
          </div>
        </div>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.liability.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.liability.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.modifications.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.modifications.text')}
        </p>
      </div>

      <div class='bg-gray-50 p-6 rounded-lg'>
        <h3 class='text-xl font-semibold text-primary-blue mb-4'>
          {t('privacy.content.jurisdiction.title')}
        </h3>
        <p class='text-gray-700 leading-relaxed'>
          {t('privacy.content.jurisdiction.text')}
        </p>
      </div>
    </article>

    <div class='mt-12 flex justify-center'>
      <div class='w-full md:w-fit min-w-48 h-full rounded-sm border-2 border-primary-coral group overflow-hidden'>
        <a href='/' class='relative block'>
          <div class='absolute inset-0 w-full h-full bg-primary-coral -translate-x-full group-hover:translate-x-0 transition-transform duration-300 ease-in-out z-0'></div>
          <div class='flex-1 relative z-10 flex flex-row items-center justify-center gap-4 px-6 py-4'>
            <h4 class='text-md font-semibold uppercase text-primary-coral transition-colors duration-300 group-hover:text-white'>
              Volver al inicio
            </h4>
          </div>
        </a>
      </div>
    </div>
  </div>
</Section>